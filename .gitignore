# ==============================================================================
# UnfluffRecipes - Git Ignore Rules
# Excludes dependencies, build outputs, Cloudflare local state, secrets, and OS files.
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build & distribution outputs
dist/
build/
.vite/

# Cloudflare Wrangler local state & secrets
.wrangler/
.dev.vars
.dev.vars.*
wrangler-logs/

# Environment files (keep .env.example template committed)
.env
.env.*
!.env.example

# Test & coverage outputs
coverage/
.vitest/
*.lcov

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Editor & OS artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
.idea/
