{
  "name": "unfluff-recipes",
  "version": "1.0.3",
  "private": true,
  "description": "Cloudflare-hosted engineering recipe compiler converting recipe URLs and raw text into Tabular Recipe Notation (TRN) with PDF export and 14-day shareable links.",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -b && tsx scripts/build.ts",
    "preview": "tsx scripts/dev.ts",
    "test": "tsx tests/runTests.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "html2pdf.js": "^0.14.0",
    "linkedom": "^0.18.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.164.0"
  }
}
